# PostgreSQL
DATABASE_URL=postgresql://registro_user:cambia-esta-clave@127.0.0.1:5432/registro_academico

# App HTTP local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false

# Reportes
REPORTS_DIR=storage/reportes

# Migracion inicial opcional desde el snapshot heredado
BOOTSTRAP_LEGACY_DATA=true
LEGACY_SNAPSHOT_PATH=app/registros.json

# Gunicorn
GUNICORN_BIND=127.0.0.1:8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
