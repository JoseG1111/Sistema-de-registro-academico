[Unit]
Description=Registro Academico web app
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/registro-academico
EnvironmentFile=/opt/registro-academico/.env
ExecStart=/opt/registro-academico/.venv/bin/gunicorn --config /opt/registro-academico/deploy/gunicorn.conf.py wsgi:app
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
